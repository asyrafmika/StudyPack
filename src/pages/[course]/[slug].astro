---
import type { GetStaticPaths } from 'astro';
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { courseIdOf, noteLabel, noteSlug, notesFor, noteUrl, progressId, url } from '../../lib/url';

export const getStaticPaths = (async () => {
  const notes = await getCollection('notes');
  return notes.map((note) => ({
    params: { course: courseIdOf(note), slug: noteSlug(note) },
    props: { note },
  }));
}) satisfies GetStaticPaths;

const { note } = Astro.props;
const courseId = courseIdOf(note);
const course = await getEntry('courses', courseId);
if (!course) throw new Error(`Note "${note.id}" is in folder "${courseId}" but no course with that id exists in courses.json`);

const siblings = await notesFor(courseId);
const idx = siblings.findIndex((n) => n.id === note.id);
const prev = siblings[idx - 1];
const next = siblings[idx + 1];
const doneId = progressId(note);
const sameWeek = siblings.filter((n) => n.data.week === note.data.week);
const { Content, headings } = await render(note);
const toc = headings.filter((h) => h.depth === 2);
---

<Base title={`${course.data.code} ${noteLabel(note)}: ${note.data.title}`} description={note.data.summary}>
  <button slot="menu-button" class="icon-btn menu-btn" id="menu-btn" type="button" aria-label="Open week list" aria-controls="sidebar" aria-expanded="false">☰</button>

  <div class="page" style={`--accent:${course.data.color}`}>
    <aside class="sidebar" id="sidebar">
      <a class="sidebar-course" href={url(`${courseId}/`)}>
        <span class="course-code">{course.data.code}</span>
        <span class="small">{course.data.title}</span>
      </a>
      <nav>
        <ol class="side-weeks">
          {
            siblings.map((n) => (
              <li>
                <a
                  href={noteUrl(n)}
                  class={n.id === note.id ? 'active' : ''}
                  aria-current={n.id === note.id ? 'page' : undefined}
                  data-progress-id={progressId(n)}
                >
                  <span class="week-num">W{n.data.week}</span>
                  <span class="side-title">{n.data.title}</span>
                  <span class="week-check" aria-hidden="true">✓</span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </aside>
    <div class="scrim" id="scrim" hidden></div>

    <main class="note">
      <nav class="crumbs small">
        <a href={url()}>Courses</a> / <a href={url(`${courseId}/`)}>{course.data.code}</a> / Week {note.data.week}{note.data.part && ` · ${note.data.part}`}
      </nav>
      <header class="note-head">
        <span class="course-code">Week {note.data.week}{note.data.part && ` · ${note.data.part}`}</span>
        {
          sameWeek.length > 1 && (
            <nav class="parts small" aria-label="Pages in this week">
              {sameWeek.map((n) =>
                n.id === note.id ? (
                  <span class="part active">{n.data.part ?? n.data.title}</span>
                ) : (
                  <a class="part" href={noteUrl(n)}>
                    {n.data.part ?? n.data.title}
                  </a>
                ),
              )}
            </nav>
          )
        }
        <h1>{note.data.title}</h1>
        {note.data.summary && <p class="muted lead">{note.data.summary}</p>}
        {
          note.data.examinedIn.length > 0 && (
            <p class="badges">
              {note.data.examinedIn.map((e) => (
                <span class="badge badge-exam">🏷️ {e}</span>
              ))}
            </p>
          )
        }
        {
          toc.length > 2 && (
            <details class="toc">
              <summary>On this page</summary>
              <ul>
                {toc.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ul>
            </details>
          )
        }
      </header>

      <article class="prose">
        <Content />
      </article>

      <div class="done-bar">
        <button type="button" class="btn" id="done-btn" data-id={doneId}>Mark as done</button>
      </div>

      <nav class="pager">
        {
          prev ? (
            <a href={noteUrl(prev)} class="pager-link">
              <span class="small muted">← {noteLabel(prev)}</span>
              <span>{prev.data.title}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a href={noteUrl(next)} class="pager-link next">
              <span class="small muted">{noteLabel(next)} →</span>
              <span>{next.data.title}</span>
            </a>
          )
        }
      </nav>
    </main>
  </div>

  <script>
    import { isDone, setDone, paintProgress } from '../../lib/progress';

    // Done button
    const btn = document.getElementById('done-btn') as HTMLButtonElement;
    const id = btn.dataset.id!;
    const sync = () => {
      const done = isDone(id);
      btn.textContent = done ? '✓ Done — mark as not done' : 'Mark as done';
      btn.classList.toggle('is-done', done);
      paintProgress();
    };
    btn.addEventListener('click', () => {
      setDone(id, !isDone(id));
      sync();
    });
    sync();

    // Mobile drawer
    const menu = document.getElementById('menu-btn')!;
    const sidebar = document.getElementById('sidebar')!;
    const scrim = document.getElementById('scrim')!;
    const setOpen = (open: boolean) => {
      sidebar.classList.toggle('open', open);
      scrim.hidden = !open;
      menu.setAttribute('aria-expanded', String(open));
    };
    menu.addEventListener('click', () => setOpen(!sidebar.classList.contains('open')));
    scrim.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
  </script>
</Base>
