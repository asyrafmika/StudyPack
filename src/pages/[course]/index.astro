---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import { sortedCourses, notesFor, url, noteUrl, progressId } from '../../lib/url';

export const getStaticPaths = (async () => {
  const courses = await sortedCourses();
  return courses.map((course) => ({ params: { course: course.id }, props: { course } }));
}) satisfies GetStaticPaths;

const { course } = Astro.props;
const c = course.data;
const notes = await notesFor(course.id);
// A week can have several pages, so group notes by week number
const byWeek = Map.groupBy(notes, (n) => n.data.week);
const planned = new Map(c.schedule.map((s) => [s.week, s]));
const weeks = Array.from({ length: c.totalWeeks }, (_, i) => i + 1);
const ids = notes.map(progressId);
// Filter chips = every assessment that at least one note is tagged with
const examFilters = [...new Set(notes.flatMap((n) => n.data.examinedIn))];
---

<Base title={c.code} description={c.description}>
  <main class="container" style={`--accent:${c.color}`}>
    <nav class="crumbs small"><a href={url()}>Courses</a> / {c.code}</nav>
    <section class="hero">
      <span class="course-code">{c.code}</span>
      <h1>{c.title}</h1>
      {c.description && <p class="muted">{c.description}</p>}
      {
        (c.lecturer || c.semester) && (
          <p class="small muted">
            {c.lecturer}
            {c.lecturer && c.semester && ' · '}
            {c.semester}
          </p>
        )
      }
      <div class="progress" data-progress-of={ids.join(',')}>
        <div class="bar"><div class="bar-fill"></div></div>
        <span class="bar-label small muted"></span>
      </div>
    </section>

    {
      (c.assessments.length > 0 || c.outcomes.length > 0) && (
        <details class="course-info">
          <summary>📋 Course info — assessment &amp; learning outcomes</summary>
          {c.assessments.length > 0 && (
            <div class="prose">
              <table>
                <thead>
                  <tr>
                    <th>Assessment</th>
                    <th>Weight</th>
                    <th>Details</th>
                  </tr>
                </thead>
                <tbody>
                  {c.assessments.map((a) => (
                    <tr>
                      <td>
                        <strong>{a.name}</strong>
                      </td>
                      <td>{a.weight}</td>
                      <td>{a.detail}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
          {c.outcomes.length > 0 && (
            <ul class="small">
              {c.outcomes.map((o) => (
                <li>{o}</li>
              ))}
            </ul>
          )}
        </details>
      )
    }

    {
      examFilters.length > 0 && (
        <div class="chips" role="group" aria-label="Filter weeks by assessment">
          <button type="button" class="chip active" data-filter="">
            All weeks
          </button>
          {examFilters.map((f) => (
            <button type="button" class="chip" data-filter={f}>
              {f}
            </button>
          ))}
        </div>
      )
    }

    <ol class="week-list">
      {
        weeks.map((w) => {
          const pages = byWeek.get(w) ?? [];
          const plan = planned.get(w);
          const events = plan?.events ?? [];
          if (plan?.isBreak) {
            return (
              <li data-exams="">
                <div class="week-row is-break">
                  <span class="week-num">W{w}</span>
                  <span class="week-text muted">☕ {plan.topic}</span>
                </div>
              </li>
            );
          }
          return pages.length ? (
            pages.map((n, i) => (
              <li data-exams={n.data.examinedIn.join('|')}>
                <a class="week-row" href={noteUrl(n)} data-progress-id={progressId(n)}>
                  <span class="week-num">W{w}</span>
                  <span class="week-text">
                    {n.data.part && <span class="small muted">{n.data.part}</span>}
                    <strong>{n.data.title}</strong>
                    {n.data.summary && <span class="small muted">{n.data.summary}</span>}
                    {(n.data.examinedIn.length > 0 || (i === 0 && events.length > 0)) && (
                      <span class="badges">
                        {n.data.examinedIn.map((e) => (
                          <span class="badge badge-exam">🏷️ {e}</span>
                        ))}
                        {i === 0 &&
                          events.map((e) => (
                            <span class="badge badge-event">📅 {e}</span>
                          ))}
                      </span>
                    )}
                  </span>
                  <span class="week-check" aria-label="Done">
                    ✓
                  </span>
                </a>
              </li>
            ))
          ) : (
            <li data-exams="">
              <div class="week-row is-empty">
                <span class="week-num">W{w}</span>
                <span class="week-text">
                  <span>{plan?.topic ?? 'Coming soon'}</span>
                  <span class="small muted">Notes coming soon</span>
                  {events.length > 0 && (
                    <span class="badges">
                      {events.map((e) => (
                        <span class="badge badge-event">📅 {e}</span>
                      ))}
                    </span>
                  )}
                </span>
              </div>
            </li>
          );
        })
      }
    </ol>
  </main>
  <script>
    import { paintProgress } from '../../lib/progress';
    paintProgress();

    // Assessment filter: show only weeks tagged with the chosen test/exam
    const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
    const rows = document.querySelectorAll<HTMLLIElement>('.week-list > li');
    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        const f = chip.dataset.filter ?? '';
        chips.forEach((c) => c.classList.toggle('active', c === chip));
        rows.forEach((li) => {
          li.hidden = f !== '' && !(li.dataset.exams ?? '').split('|').includes(f);
        });
      }),
    );
  </script>
</Base>
