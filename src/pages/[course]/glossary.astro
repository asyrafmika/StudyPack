---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import { sortedCourses, notesFor, noteLabel, noteUrl, url } from '../../lib/url';
import { examFor } from '../../lib/exam';

export const getStaticPaths = (async () => {
  const courses = await sortedCourses();
  return courses.map((course) => ({ params: { course: course.id }, props: { course } }));
}) satisfies GetStaticPaths;

const { course } = Astro.props;
const notes = await notesFor(course.id);
const rows = (
  await Promise.all(
    notes.map(async (n) => ((await examFor(n))?.terms ?? []).map((t) => ({ ...t, href: noteUrl(n), label: noteLabel(n) }))),
  )
)
  .flat()
  .sort((a, b) => a.term.localeCompare(b.term, 'en', { sensitivity: 'base' }));
const letterOf = (t: string) => (/[a-z]/i.test(t[0]) ? t[0].toUpperCase() : '#');
const groups = Map.groupBy(rows, (r) => letterOf(r.term));
---

<Base title={`Glossary · ${course.data.code}`} description={`Every key term in ${course.data.title}`}>
  <main class="xp" style={`--accent:${course.data.color}`}>
    <nav class="crumbs small"><a href={url()}>Courses</a> / <a href={url(`${course.id}/`)}>{course.data.code}</a> / Glossary</nav>
    <header class="xp-head">
      <p class="course-code">{course.data.code} · Glossary</p>
      <h1 class="serif">Every term, <em>in plain words</em></h1>
      <p class="muted">{rows.length} terms from {course.data.title}, each linked to the week it comes from.</p>
      <div class="gl-search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
        <input id="gl-q" type="search" placeholder="Filter terms…" autocomplete="off" />
        <span class="small muted" id="gl-count"></span>
      </div>
      <nav class="gl-letters" aria-label="Jump to letter">
        {[...groups.keys()].map((l) => <a href={`#l-${l}`}>{l}</a>)}
      </nav>
    </header>

    {
      [...groups.entries()].map(([l, items]) => (
        <section class="gl-group" id={`l-${l}`}>
          <h2 class="serif">{l}</h2>
          <dl>
            {items.map((t) => (
              <div class="gl-row" data-text={`${t.term} ${t.def}`.toLowerCase()}>
                <dt>{t.term}</dt>
                <dd>
                  <span set:html={t.def} />
                  <a class="gl-src" href={t.href}>{t.label}</a>
                </dd>
              </div>
            ))}
          </dl>
        </section>
      ))
    }
    <p class="muted gl-empty" id="gl-empty" hidden>No terms match.</p>
  </main>
  <script>
    const q = document.getElementById('gl-q') as HTMLInputElement;
    const rows = [...document.querySelectorAll<HTMLElement>('.gl-row')];
    const groups = [...document.querySelectorAll<HTMLElement>('.gl-group')];
    const count = document.getElementById('gl-count')!;
    const update = () => {
      const v = q.value.toLowerCase().trim();
      let n = 0;
      rows.forEach((r) => {
        const show = !v || r.dataset.text!.includes(v);
        r.hidden = !show;
        if (show) n++;
      });
      groups.forEach((g) => (g.hidden = !g.querySelector('.gl-row:not([hidden])')));
      count.textContent = v ? `${n} match${n === 1 ? '' : 'es'}` : '';
      document.getElementById('gl-empty')!.hidden = n > 0;
    };
    q.addEventListener('input', update);
  </script>
</Base>
