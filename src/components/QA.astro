/**
 * One flashcard question. Written inside a note's MDX so questions live next to
 * the content they test, but NOT rendered on the note page: the flashcard page
 * (src/pages/[course]/[slug]/flashcards.astro) extracts them from the source.
 *
 * <QA q="Question?" level="easy|medium|hard" why="Explanation shown if the learner gets it wrong">
 *   Answer in **markdown**.
 * </QA>
 */
interface Props {
  q: string;
  level?: 'easy' | 'medium' | 'hard';
  why?: string;
}
