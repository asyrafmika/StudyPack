---
/**
 * Image with caption. Images are optimised at build time (resized, WebP).
 *
 * import img from './images/w01-osi.png';
 * <Figure src={img} alt="OSI model layers" caption="Focus on layers 3 and 4." />
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** Source slide, e.g. "Lecture 1, slide 12" */
  credit?: string;
  /** Max display width in px — use for small/blurry or very tall images */
  max?: number;
}
const { src, alt, caption, credit, max } = Astro.props;
---

<figure class="figure" style={max ? `--fig-max:${max}px` : undefined}>
  <a href={src.src} target="_blank" rel="noopener" title="Open full size">
    <Image src={src} alt={alt} widths={[480, 800, 1200]} sizes="(max-width: 860px) 100vw, 760px" />
  </a>
  {
    (caption || credit) && (
      <figcaption>
        {caption}
        {credit && <span class="credit"> — {credit}</span>}
      </figcaption>
    )
  }
</figure>
